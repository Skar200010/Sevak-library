# ===== Supabase (required) =====
# Project URL and keys from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vite reads these in the frontend folder (sevak library/.env)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ===== Admin login (for the staff panel) =====
ADMIN_EMAIL=admin@sevaklibrary.org
ADMIN_PASSWORD=ChangeMe-12345

# ===== Email (Resend) for membership ID emails =====
# Optional - without it, the Edge Function logs the email instead of sending.
RESEND_API_KEY=
MAIL_FROM=Sevak Library <no-reply@sevaklibrary.org>
